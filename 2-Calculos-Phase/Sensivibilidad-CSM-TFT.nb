Cell[BoxData[
 RowBox[{
  RowBox[{"deltaLambda", "[", "list_List", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", "-", 
            RowBox[{"First", "[", "#1", "]"}]}], "&"}], ")"}], "[", 
         RowBox[{"#1", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "]"}], "&"}], 
       ")"}], "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"#1", ",", "1"}], "]"}], "]"}], "&"}], ")"}], "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"MaximalBy", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "#1", "]"}], ",", "Last"}], "]"}], "&"}], ")"}], "/@",
     "list"}], "]"}]}]], "Code",
 CellLabel->
  "In[784]:=",ExpressionUUID->"63afc2ce-dcee-4b41-a386-5b2d4ee90b6c"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"dataLda", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Transpose", "[", 
       RowBox[{"{", 
        RowBox[{"lda", ",", "#"}], "}"}], "]"}], "&"}], ",", "cdata", ",", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"dataLda", " ", "=", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"CentralFiniteDifferences", "[", 
        RowBox[{"#", ",", "1"}], "]"}], "&"}], ",", "dataLda", ",", 
      RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\n"}], "\n", 
