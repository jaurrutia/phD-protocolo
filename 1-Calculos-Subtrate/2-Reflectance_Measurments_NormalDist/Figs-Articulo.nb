Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"texLegendTeo", " ", "=", " ", 
    RowBox[{"Function", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"str", ",", "col"}], "}"}], ",", "\n", "                ", 
      RowBox[{
       RowBox[{
        RowBox[{"MaTeX", "[", 
         RowBox[{
          RowBox[{"\"\<\\\\color[RGB]\>\"", "<>", 
           RowBox[{"ToString", "[", "col", "]"}], "<>", " ", "#"}], ",", 
          RowBox[{"FontSize", "\[Rule]", "8"}], ",", "  ", 
          RowBox[{"\"\<Preamble\>\"", "\[Rule]", 
           RowBox[{"{", "\"\<\\\\usepackage{color}\>\"", "}"}]}], ",", 
          RowBox[{"ContentPadding", "->", "False"}], ",", 
          RowBox[{"FontSize", "\[Rule]", "8"}]}], "]"}], " ", "&"}], "/@", 
       RowBox[{"{", "\n", "                    ", 
        RowBox[{
         RowBox[{"\"\<a^\\\\text{CSM}_\\\\text{Fit}= \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"str", "[", 
            RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", 
          "\"\< \\\\text{ nm}\>\""}], ",", " ", 
         RowBox[{"\"\<\\\\Theta^\\\\text{CSM}_\\\\text{Fit} = \>\"", "<>", 
          RowBox[{"ToString", "[", 
           RowBox[{"str", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "\n", 
        "                  ", "}"}]}]}], "]"}]}], ";"}], "\n", 
  "                  "}], "\n", 
 RowBox[{
  RowBox[{"legends", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"texLegendTeo", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"radiusS", ",", "cfracS", ",", " ", 
         RowBox[{"{", 
          RowBox[{"RGBcolors", ",", "RGBcolors"}], "}"}]}], "}"}], ",", "2"}],
       "]"}], ",", "\n", "          ", 
     RowBox[{"MapThread", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"texLegendTeo", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"#1", ",", "#2"}], "}"}], ",", "#3"}], "]"}], "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"radiusP", ",", "cfracP", ",", " ", 
         RowBox[{"{", 
          RowBox[{"RGBcolors", ",", "RGBcolors"}], "}"}]}], "}"}], ",", "2"}],
       "]"}]}], "}"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{"pol", ",", "ang", ",", "sample", ",", "text"}], "]"}], "]"}], 
   "*)"}], "\n", "          "}], "\n", 
 RowBox[{"legends", " ", "=", " ", 
  RowBox[{"Map", "[", 
   RowBox[{
    RowBox[{
