           RowBox[{"\"\<\\\\color[RGB]\>\"", "<>", 
            RowBox[{"ToString", "[", "col", "]"}], "<>", " ", "#"}], ",", 
           RowBox[{"FontSize", "\[Rule]", "12"}], ",", "  ", 
