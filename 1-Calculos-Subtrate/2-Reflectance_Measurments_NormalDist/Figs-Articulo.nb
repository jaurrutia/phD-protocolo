        RowBox[{"{", "\n", "                    ", 
         RowBox[{
          RowBox[{"\"\<a^\\\\text{CSM}= \>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"str", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", 
           "\"\< \\\\text{ nm}\>\""}], ",", " ", 
          RowBox[{"\"\<\\\\Theta^\\\\text{CSM} = \>\"", "<>", 
           RowBox[{"ToString", "[", 
            RowBox[{"str", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}]}]}], "\n", 
         "                  ", "}"}]}]}], "]"}]}], ";"}], "               ", 
