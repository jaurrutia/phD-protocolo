   "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"plots", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"ListLinePlot", "[", 
       RowBox[{"#1", ",", 
