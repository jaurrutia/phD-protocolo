            RowBox[{"\"\<SizeDistribution\>\"", "->", "\"\<Normal\>\""}]}], 
           "]"}], "]"}]}], ")"}], "&"}], ",", "\[IndentingNewLine]", 
      RowBox[{"{", 
       RowBox[{"muSigma", ",", "cfrac"}], "}"}]}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{"case", ",", " ", "pol", ",", "ang", ",", "lda"}], "]"}], "]"}], 
   "*)"}], "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"teoPoly", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"teoPoly", ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "1", ",", "2", ",", "4"}], "}"}]}], "]"}]}], 
