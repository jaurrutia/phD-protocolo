Cell[CellGroupData[{

Cell["Poly", "Subsubsection",
 CellChangeTimes->{{3.872036450266974*^9, 
  3.872036450963278*^9}},ExpressionUUID->"3e36d24a-9a9d-4a8e-a0b7-\
e32041c48d88"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"dist", " ", "=", " ", 
  RowBox[{"MapThread", "[", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"(", "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"mu", " ", "=", " ", 
        RowBox[{"First", "[", "#1", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"sigma", " ", "=", " ", 
        RowBox[{"Last", "[", "#1", "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"rhost", " ", "=", " ", 
        RowBox[{"#2", "/", 
         RowBox[{"(", 
          RowBox[{"Pi", " ", "*", " ", 
           RowBox[{"mu", "^", "2"}]}], ")"}]}]}], ";", "\[IndentingNewLine]", 
       
       RowBox[{"sizeDist", " ", "=", " ", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"x", ",", "mi", ",", "sgma"}], "}"}], ",", 
          RowBox[{"rhost", " ", "*", " ", 
           RowBox[{"PDF", "[", 
            RowBox[{
             RowBox[{"NormalDistribution", "[", 
              RowBox[{"mi", ",", "sgma"}], "]"}], ",", "x"}], "]"}]}]}], 
         "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Plot", "[", 
        RowBox[{
         RowBox[{"sizeDist", "[", 
          RowBox[{"x", ",", "mu", ",", "sigma"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"x", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"#", "<=", "0"}], ",", "0", ",", "#"}], "]"}], "&"}], 
            "[", 
            RowBox[{"mu", "-", 
             RowBox[{"5", "*", "sigma"}]}], "]"}], ",", 
           RowBox[{"mu", "+", 
            RowBox[{"5", "*", "sigma"}]}]}], "}"}], ",", 
         RowBox[{"PlotRange", "\[Rule]", "All"}], ",", 
         RowBox[{"Mesh", "\[Rule]", "Full"}], ",", 
         RowBox[{"PlotStyle", "\[Rule]", 
          RowBox[{"colors", "[", 
           RowBox[{"[", "#3", "]"}], "]"}]}], ",", 
         RowBox[{"Filling", "\[Rule]", "Bottom"}]}], "]"}]}], ")"}], "&"}], 
    ",", "\[IndentingNewLine]", 
    RowBox[{"{", 
     RowBox[{"muSigma", ",", "cfrac", ",", 
      RowBox[{"Range", "[", 
       RowBox[{"Length", "[", "cfrac", "]"}], "]"}]}], "}"}]}], 
   "]"}]}]], "Code",
 CellChangeTimes->{{3.885378130838316*^9, 3.885378134141428*^9}, {
   3.885378170721817*^9, 3.885378194230492*^9}, {3.885378239925506*^9, 
