Cell[BoxData[{
 RowBox[{
  RowBox[{"nM", " ", "=", " ", 
   RowBox[{"nMat", "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"teoPoly", " ", "=", " ", 
    RowBox[{"MapThread", "[", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"(", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"mu", " ", "=", " ", 
          RowBox[{"First", "[", "#1", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"sigma", " ", "=", " ", 
          RowBox[{"Last", "[", "#1", "]"}]}], ";", "\[IndentingNewLine]", 
         RowBox[{"indAu", " ", "=", " ", 
          RowBox[{"Transpose", "[", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"nM", ",", "1.5"}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "wlen"}], "}"}]}], "]"}], "]"}]}], ";", 
         "\[IndentingNewLine]", "\t\t\t", 
         RowBox[{"norm2", "[", 
          RowBox[{"CSMBioReflectionInt", "[", 
           RowBox[{"ang", ",", "indAu", ",", "wlen", ",", "#2", ",", 
            RowBox[{"{", 
