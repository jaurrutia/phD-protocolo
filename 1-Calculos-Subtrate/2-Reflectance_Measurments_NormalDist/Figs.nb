Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"indAu", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nM", ",", "1.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "lambda"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bestRadius", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sigma", " ", "=", " ", 
       RowBox[{"muSigma", "[", 
        RowBox[{"[", 
         RowBox[{"c", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "            ", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{
        RowBox[{"norm2", "[", 
         RowBox[{
          RowBox[{"CSMBioReflectionInt", "[", 
           RowBox[{
            RowBox[{"ang", "[", 
             RowBox[{"[", "t", "]"}], "]"}], ",", "indAu", ",", "lambda", ",", 
            RowBox[{"cfrac", "[", 
             RowBox[{"[", "c", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"#", ",", "sigma"}], "}"}], ",", 
            RowBox[{"\"\<SizeDistribution\>\"", "->", "\"\<Normal\>\""}]}], 
           "]"}], "[", 
          RowBox[{"[", "pol", "]"}], "]"}], "]"}], "&"}]}], ";", "\n", 
      "            ", 
      RowBox[{"y", " ", "=", " ", 
       RowBox[{"spectra", "[", 
        RowBox[{"[", 
         RowBox[{"pol", ",", "t", ",", "c", ",", "take", ",", "2"}], "]"}], 
        "]"}]}], ";", "\n", "            ", 
      RowBox[{"error", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Plus", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"f", "[", "#", "]"}], " ", "-", " ", "y"}], ")"}]}], "^",
           "2"}], "/", 
         RowBox[{"Length", "[", "lambda", "]"}]}], "&"}]}], ";", "\n", 
      "            ", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"AbsoluteTiming", "[", "\n", "            ", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"NGradientDescent", "[", 
           RowBox[{"error", ",", 
            RowBox[{"{", "5.", "}"}], ",", 
            RowBox[{
            "LearningRate", " ", "->", " ", "\"\<Barzilai-Borwein\>\""}], ",", 
            RowBox[{"Tolerance", "->", " ", "1.*^-5"}]}], "]"}], ",", "\n", 
          "            ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<s Pol\>\"", ",", "\"\<p Pol\>\""}], "}"}], "[", 
             RowBox[{"[", "pol", "]"}], "]"}], ",", " ", 
            RowBox[{"t", "*", 
             RowBox[{"180.", "/", "Pi"}]}], ",", 
            RowBox[{"muSigma", "[", 
             RowBox[{"[", 
              RowBox[{"c", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        "]"}]}], ";", "\n", "            ", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Date", "[", "]"}], ",", " ", "\"\<\\n\>\"", ",", " ", 
         "result"}], "}"}], "]"}], ";", "\n", "            ", "result"}], ",",
      "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"pol", ",", " ", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "}"}], ",", "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", 
       RowBox[{"Length", "[", "ang", "]"}]}], "}"}], ",", "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"c", ",", 
       RowBox[{"Length", "[", "muSigma", "]"}]}], "}"}]}], "]"}]}], 
  "\n"}], "\n", 
 RowBox[{"Prepend", "[", 
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"bestRadius", "[", 
          RowBox[{"[", 
           RowBox[{"#1", ",", "#2", ",", "#3"}], "]"}], "]"}], "]"}], " ", 
        "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", "2"}], "]"}], 
   ",", "\n", 
   RowBox[{"{", 
    RowBox[{
    "\"\<Time\>\"", ",", "\"\<Pol\>\"", ",", " ", "\"\<ang\>\"", ",", 
     "\"\<mu\>\"", ",", "\"\<Best Radius\>\"", ",", "\"\<Error\>\""}], 
    "}"}]}], "]"}], "\n", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<BestRadiusFit-450nm-850nm-denser.csv\>\"", ",", "%"}], 
  "]"}]}], "Code",
 CellChangeTimes->{{3.887762634970607*^9, 3.8877626626919928`*^9}, {
  3.887762869628262*^9, 3.887762988689493*^9}, {3.887763072965399*^9, 
