Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"indAu", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
    RowBox[{"Table", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"nM", ",", "1.5"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"i", ",", "lambda"}], "}"}]}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"bestRadiusAmp", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"sigma", " ", "=", " ", 
       RowBox[{"muSigma", "[", 
        RowBox[{"[", 
         RowBox[{"c", ",", "2"}], "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "            ", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{
        RowBox[{"norm2", "[", 
         RowBox[{
          RowBox[{"CSMBioReflectionInt", "[", 
           RowBox[{
            RowBox[{"ang", "[", 
             RowBox[{"[", "t", "]"}], "]"}], ",", "indAu", ",", "lambda", ",", 
            RowBox[{"cfrac", "[", 
             RowBox[{"[", "c", "]"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"#", ",", "sigma"}], "}"}], ",", 
            RowBox[{"\"\<SizeDistribution\>\"", "->", "\"\<Normal\>\""}]}], 
           "]"}], "[", 
          RowBox[{"[", "pol", "]"}], "]"}], "]"}], "&"}]}], ";", "\n", 
      "            ", 
      RowBox[{"y", " ", "=", " ", 
       RowBox[{"spectra", "[", 
        RowBox[{"[", 
         RowBox[{"pol", ",", "t", ",", "c", ",", "take", ",", "2"}], "]"}], 
        "]"}]}], ";", "\n", "            ", 
      RowBox[{"error", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Plus", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"#2", "*", 
              RowBox[{"f", "[", "#1", "]"}]}], " ", "-", " ", "y"}], ")"}]}], 
          "^", "2"}], "/", 
         RowBox[{"Length", "[", "lambda", "]"}]}], "&"}]}], ";", "\n", 
      "            ", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"AbsoluteTiming", "[", "\n", "            ", 
        RowBox[{"Prepend", "[", 
         RowBox[{
          RowBox[{"NGradientDescent", "[", 
           RowBox[{"error", ",", 
            RowBox[{"{", 
             RowBox[{"5.", ",", ".5"}], "}"}], ",", 
            RowBox[{
            "LearningRate", " ", "->", " ", "\"\<Barzilai-Borwein\>\""}], ",", 
            RowBox[{"Tolerance", "->", " ", "1.*^-4"}]}], "]"}], ",", "\n", 
          "            ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<s Pol\>\"", ",", "\"\<p Pol\>\""}], "}"}], "[", 
             RowBox[{"[", "pol", "]"}], "]"}], ",", " ", 
            RowBox[{"t", "*", 
             RowBox[{"180.", "/", "Pi"}]}], ",", 
            RowBox[{"muSigma", "[", 
             RowBox[{"[", 
              RowBox[{"c", ",", "1"}], "]"}], "]"}]}], "}"}]}], "]"}], 
        "]"}]}], ";", "\n", "            ", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Date", "[", "]"}], ",", " ", "\"\<\\n\>\"", ",", " ", 
         "result"}], "}"}], "]"}], ";", "\n", "            ", "result"}], ",",
      "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"pol", ",", " ", 
       RowBox[{"{", "1", "}"}]}], "}"}], ",", "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", 
       RowBox[{"Length", "[", "ang", "]"}]}], "}"}], ",", "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"c", ",", 
       RowBox[{"Length", "[", "muSigma", "]"}]}], "}"}]}], "]"}]}], 
  "\n"}], "\n", 
 RowBox[{"Prepend", "[", 
  RowBox[{
   RowBox[{"Flatten", "[", 
    RowBox[{
     RowBox[{"Array", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{"bestRadiusAmp", "[", 
          RowBox[{"[", 
           RowBox[{"#1", ",", "#2", ",", "#3"}], "]"}], "]"}], "]"}], " ", 
        "&"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "2", ",", "2"}], "}"}]}], "]"}], ",", "2"}], "]"}], 
   ",", "\n", 
   RowBox[{"{", 
    RowBox[{
    "\"\<Time\>\"", ",", "\"\<Pol\>\"", ",", " ", "\"\<ang\>\"", ",", 
     "\"\<mu\>\"", ",", "\"\<Best Radius\>\"", ",", "\"\<Offset\>\"", ",", 
     "\"\<Error\>\""}], "}"}]}], "]"}], "\n", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<BestRadiusOffsetFit-450nm-850nm-denser.csv\>\"", ",", "%"}], 
  "]"}]}], "Code",
 CellChangeTimes->{{3.8878929816999607`*^9, 3.887893029818717*^9}, {
