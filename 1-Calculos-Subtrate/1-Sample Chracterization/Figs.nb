Cell[CellGroupData[{

Cell["Individual fits", "Subsubsection",
 CellChangeTimes->{{3.878930044883923*^9, 
  3.8789300475793333`*^9}},ExpressionUUID->"1175ac58-a4d6-47bb-9dde-\
56ec822cafbc"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"normal", " ", "=", " ", 
   RowBox[{
    RowBox[{"a", " ", "*", " ", 
     RowBox[{"PDF", "[", 
      RowBox[{
       RowBox[{"NormalDistribution", "[", 
        RowBox[{"mu", ",", "sigma"}], "]"}], ",", "#"}], "]"}]}], "&"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"fits", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"NonlinearModelFit", "[", 
       RowBox[{"#", ",", 
        RowBox[{"normal", "[", "x", "]"}], ",", 
        RowBox[{"{", 
         RowBox[{"a", ",", "mu", ",", "sigma"}], "}"}], ",", "x"}], "]"}], 
      "&"}], ",", "data"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"info", " ", "=", " ", 
    RowBox[{"Map", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<BestFitParameters\>\"", "]"}], "&"}], ",", 
      "fits"}], "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{"MapThread", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"Plot", "[", 
     RowBox[{
      RowBox[{"#1", "[", "x", "]"}], ",", 
      RowBox[{"{", 
       RowBox[{"x", ",", 
        RowBox[{"#2", "[", 
         RowBox[{"[", 
          RowBox[{"1", ",", "1"}], "]"}], "]"}], ",", 
        RowBox[{"#2", "[", 
         RowBox[{"[", 
          RowBox[{
           RowBox[{"-", "1"}], ",", "1"}], "]"}], "]"}]}], "}"}], ",", "\n", 
      RowBox[{"PlotRange", "\[Rule]", "Full"}], ",", 
      RowBox[{"Epilog", " ", "->", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Point", "[", "#2", "]"}], ",", 
         RowBox[{"Line", "[", "#2", "]"}]}], "}"}]}], ",", "\n", 
      RowBox[{"PlotLabel", "->", 
       RowBox[{"(", 
        RowBox[{"Style", "[", 
         RowBox[{
          RowBox[{"StringJoin", "@", 
           RowBox[{"legends", "[", 
            RowBox[{"infoList", "[", "#1", "]"}], "]"}]}], ",", "texStyle"}], 
         "]"}], ")"}]}], ",", "\n", 
      RowBox[{"Evaluate", "[", "graphsOptsExp", "]"}], ",", "\n", 
      RowBox[{"FrameLabel", "\[Rule]", 
       RowBox[{"{", 
        RowBox[{"\"\<Eq. radius [nm]\>\"", ",", "\"\<Counts\>\""}], "}"}]}]}],
      "\n", "]"}], "&"}], ",", 
   RowBox[{"{", 
    RowBox[{"fits", ",", "data"}], "}"}]}], "]"}]}], "Code",
