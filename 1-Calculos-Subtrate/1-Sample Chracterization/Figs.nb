Cell[BoxData[{
 RowBox[{
  RowBox[{"files", " ", "=", " ", 
   RowBox[{
    RowBox[{"FileNames", "[", 
     RowBox[{"\"\<*.txt\>\"", ",", "\"\<1-Distribuciones\>\""}], "]"}], "[", 
    RowBox[{"[", 
     RowBox[{";;", "5"}], "]"}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"data", " ", "=", " ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"Drop", "[", 
        RowBox[{
         RowBox[{"Import", "[", 
          RowBox[{"#", ",", "\"\<Data\>\""}], "]"}], ",", "2"}], "]"}], "/.", 
       
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x_", ",", "y_"}], "}"}], "->", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"x", "*", "1*^9"}], ",", "y"}], "}"}]}]}], " ", "&"}], " ", 
     "/@", " ", "files"}]}], ";"}], "  ", 
  RowBox[{"(*", 
   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{"file", ",", " ", "raddi", ",", " ", "counts"}], "]"}], "]"}], 
   "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"thicknes", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"3", ",", "3", ",", "3", ",", "5", ",", "5"}], "}"}]}], ";"}], 
  "\n"}], "\n", 
 RowBox[{
  RowBox[{"infoList", " ", "=", " ", 
   RowBox[{
    RowBox[{"Append", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"#", "[", "\"\<ParameterTableEntries\>\"", "]"}], "[", 
       RowBox[{"[", 
        RowBox[{";;", ",", 
         RowBox[{";;", "2"}]}], "]"}], "]"}], ",", 
      RowBox[{"#", "[", "\"\<RSquared\>\"", "]"}]}], "]"}], "&"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"legends", "[", "list_", "]"}], ":=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#1", "<>", "\"\< -> \>\"", "<>", " ", 
       RowBox[{"ToString", "[", 
        RowBox[{"#2", "[", 
         RowBox[{"[", "1", "]"}], "]"}], "]"}], "<>", "\"\<\[PlusMinus]\>\"", 
       "<>", 
       RowBox[{"ToString", "[", 
        RowBox[{"#2", "[", 
         RowBox[{"[", "2", "]"}], "]"}], "]"}], "<>", "\"\<\\n\>\""}], "&"}], 
     ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<a\>\"", ",", "\"\<\[Mu]\>\"", ",", "\"\<\[Sigma]\>\""}], 
        "}"}], ",", 
       RowBox[{"Drop", "[", 
        RowBox[{"list", ",", 
         RowBox[{"-", "1"}]}], "]"}]}], "}"}]}], "]"}]}], ";"}]}], "Code",
 CellChangeTimes->{{3.887365593606433*^9, 3.887365676257534*^9}},
