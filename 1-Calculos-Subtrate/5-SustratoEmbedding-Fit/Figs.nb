Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleFactor", "[", "h_", "]"}], ":=", 
    RowBox[{"0.5", " ", "-", " ", 
     RowBox[{"0.75", "*", "h"}], " ", "+", " ", 
     RowBox[{"0.25", "*", "h", "*", "h", "*", "h"}]}]}], " ", ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"h", " ", "->", " ", 
     RowBox[{"Incrustation", " ", 
      RowBox[{"factor", ":", " ", 
       RowBox[{
        RowBox[{"h", "/", 
         RowBox[{"a", ".", " ", "h"}]}], " ", "Distance", " ", "between", " ",
         "center", " ", "and", " ", "interface"}]}]}]}], ",", " ", 
    RowBox[{"a", " ", "AuNP", " ", "radius"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"radiusM", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"5.78", ",", " ", "7.30"}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"radiusF", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"3.3", ",", " ", "4.5"}], "}"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"graphsOpts", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Mesh", "->", " ", "None"}], ",", 
     RowBox[{"BaseStyle", "\[Rule]", " ", "texStyle"}], ",", 
     RowBox[{"Frame", "\[Rule]", " ", "True"}], ",", " ", 
     RowBox[{"FrameStyle", "\[Rule]", " ", "Black"}], ",", 
     RowBox[{"ImageSize", "->", " ", 
      RowBox[{"685", "*", 
       RowBox[{"2", "/", "5"}]}]}]}], "}"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"graphsH", " ", "=", " ", 
   RowBox[{"MapIndexed", "[", " ", 
    RowBox[{
     RowBox[{
      RowBox[{"Plot", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"scaleFactor", "[", "h", "]"}], "-", "#1"}], " ", ",", 
        RowBox[{"{", 
         RowBox[{"h", ",", 
          RowBox[{"-", "1"}], ",", "1"}], "}"}], ",", 
        RowBox[{"Evaluate", "[", "graphsOpts", "]"}], ",", 
        RowBox[{"PlotStyle", "\[Rule]", 
         RowBox[{"First", "[", "#2", "]"}]}]}], "]"}], "&"}], " ", ",", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"radiusF", "/", "radiusM"}], ")"}], "^", "3"}], ")"}]}], 
    "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"roots", " ", "=", " ", 
   RowBox[{
    RowBox[{
     RowBox[{"FindRoot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"scaleFactor", "[", "h", "]"}], "-", 
         RowBox[{"#", "^", "3"}]}], " ", "==", " ", "0"}], ",", " ", 
       RowBox[{"{", 
        RowBox[{"h", ",", ".1"}], "}"}]}], " ", "]"}], " ", "&"}], " ", "/@", 
    " ", 
    RowBox[{"(", 
     RowBox[{"radiusF", "/", "radiusM"}], ")"}]}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"fplot", " ", "=", " ", 
   RowBox[{"Show", "[", 
    RowBox[{"graphsH", ",", " ", 
     RowBox[{"ListPlot", "[", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Callout", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"h", ",", "0"}], "}"}], ",", "h"}], "]"}], " ", "/.", " ",
          "roots"}], ")"}], ",", 
       RowBox[{"PlotStyle", "->", 
        RowBox[{"PointSize", "[", ".025", "]"}]}]}], "]"}], ",", "\n", 
     "            ", 
     RowBox[{"FrameLabel", "->", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<h/a\>\"", ",", 
          RowBox[{"FontSize", "\[Rule]", "fs"}]}], "]"}], ",", 
        RowBox[{"MaTeX", "[", 
         RowBox[{"\"\<f(h/a)\>\"", ",", 
          RowBox[{"FontSize", "\[Rule]", "fs"}]}], "]"}]}], "}"}]}]}], 
    "]"}]}], "\n", "            "}], "\n", 
 RowBox[{
  RowBox[{"(", 
   RowBox[{"h", " ", "/.", " ", "roots"}], ")"}], "*", "radiusM"}], "\n", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<S1-Embedding.svg\>\"", ",", "fplot"}], "]"}], "\n", 
 RowBox[{"Export", "[", 
  RowBox[{"\"\<S1-Embedding-Labels.svg\>\"", ",", " ", 
