 RowBox[{
  RowBox[{"deltaLambda", "[", "list_List", "]"}], ":=", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"#1", "-", 
            RowBox[{"First", "[", "#1", "]"}]}], "&"}], ")"}], "[", 
         RowBox[{"#1", "\[LeftDoubleBracket]", 
          RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "]"}], "&"}], 
       ")"}], "[", 
      RowBox[{"Flatten", "[", 
       RowBox[{"#1", ",", "1"}], "]"}], "]"}], "&"}], ")"}], "[", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"MaximalBy", "[", 
       RowBox[{
        RowBox[{"Abs", "[", "#1", "]"}], ",", "Last"}], "]"}], "&"}], ")"}], "/@",
     "list"}], "]"}]}]], "Code",
