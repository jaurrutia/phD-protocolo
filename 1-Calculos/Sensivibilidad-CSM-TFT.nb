            RowBox[{"Mesh", "->", "All"}], ",", " ", 
            RowBox[{"Evaluate", "[", "graphsOptsPhase", "]"}], ",", 
            RowBox[{"PlotRange", "->", "All"}], ",", "\n", "            ", 
            RowBox[{"PlotStyle", "->", 
             RowBox[{"Directive", "[", 
              RowBox[{
               RowBox[{"Thickness", "[", ".01", "]"}], ",", 
               RowBox[{"PointSize", "[", ".03", "]"}], ",", "Dashed"}], 
              "]"}]}], ",", "\n", "            ", 
            RowBox[{"ColorFunction", " ", "->", " ", 
             RowBox[{"ColorMapSuite", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"{", 
                 RowBox[{"\"\<lajolla\>\"", ",", "\"\<oslo\>\""}], "}"}], "[", 
                RowBox[{"[", 
                 RowBox[{"First", "[", "#2", "]"}], "]"}], "]"}], ",", "1"}], 
              "]"}]}]}], "]"}], "&"}], ",", "\n", "          ", "dLdaSPP"}], 
        "]"}]}]}], "\n", "          ", "]"}], ";"}], "\n", 
   RowBox[{
