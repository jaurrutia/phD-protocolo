     RowBox[{"{", "2", "}"}]}], "]"}]}], 
  RowBox[{"(*", 
   RowBox[{"Choosing", " ", "in", " ", "the", " ", "Visible"}], "*)"}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectra", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"#", "[", 
          RowBox[{"[", 
           RowBox[{"{", 
            RowBox[{"1", ",", "i"}], "}"}], "]"}], "]"}], "*", 
         RowBox[{"{", 
          RowBox[{"1", ",", ".01"}], "}"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "2", ",", 
          RowBox[{"Length", "[", "#", "]"}]}], "}"}]}], "]"}], "&"}], ",", 
     "spectra", ",", 
     RowBox[{"{", "3", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectra", " ", "=", " ", 
   RowBox[{"Transpose", "[", 
