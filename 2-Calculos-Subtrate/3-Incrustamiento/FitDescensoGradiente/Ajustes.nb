Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bestFit", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", "\n", "            ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mu", ",", " ", "sigma"}], "}"}], " ", "=", " ", 
       RowBox[{"muSigma", "[", 
        RowBox[{"[", "c", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "            ", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{
        RowBox[{"norm2", "[", 
         RowBox[{
          RowBox[{"CSMBioReflectionInt", "[", 
           RowBox[{
            RowBox[{"ang", "[", 
             RowBox[{"[", "t", "]"}], "]"}], ",", "\n", 
            "                                          ", 
            RowBox[{"Transpose", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"#", ",", "1.5"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "lambda"}], "}"}]}], "]"}], "]"}], ",", " ", 
            RowBox[{"(*", 
             RowBox[{"{", 
              RowBox[{"nMat", ",", " ", "nSus"}], "}"}], "*)"}], "\n", 
            "                                          ", "lambda", ",", "\n",
             "                                          ", 
            RowBox[{"cfrac", "[", 
             RowBox[{"[", "c", "]"}], "]"}], ",", "\n", 
            "                                          ", 
            RowBox[{"muSigma", "[", 
             RowBox[{"[", "c", "]"}], "]"}], ",", "\n", 
            "                                          ", 
            RowBox[{"\"\<SizeDistribution\>\"", "->", "\"\<Normal\>\""}]}], 
           "]"}], "[", 
          RowBox[{"[", "pol", "]"}], "]"}], "]"}], "&"}]}], ";", "\n", 
      "            ", 
      RowBox[{"y", " ", "=", " ", 
       RowBox[{"spectra", "[", 
        RowBox[{"[", 
         RowBox[{"pol", ",", "t", ",", "c", ",", "take", ",", "2"}], "]"}], 
        "]"}]}], ";", "\n", "            ", 
      RowBox[{"error", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Plus", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"f", "[", "#", "]"}], " ", "-", " ", "y"}], ")"}]}], "^",
           "2"}], "/", 
         RowBox[{"Length", "[", "lambda", "]"}]}], "&"}]}], ";", "\n", 
      "            ", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"AbsoluteTiming", "[", "\n", "                        ", 
        RowBox[{"Prepend", "[", "\n", "                              ", 
         RowBox[{
          RowBox[{"NGradientDescent", "[", 
           RowBox[{"error", ",", 
