Cell[BoxData[{
 RowBox[{
  RowBox[{"spectra", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Drop", "[", 
       RowBox[{"#", ",", "4"}], "]"}], "&"}], ",", " ", "data", ",", 
