Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"bestFit", " ", "=", " ", 
   RowBox[{"ParallelTable", "[", "\n", "            ", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"mu", ",", " ", "sigma"}], "}"}], " ", "=", " ", 
       RowBox[{"muSigma", "[", 
        RowBox[{"[", "c", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
      "            ", 
      RowBox[{"f", " ", "=", " ", 
       RowBox[{
        RowBox[{"norm2", "[", 
         RowBox[{
          RowBox[{"CSMBioReflectionInt", "[", 
           RowBox[{
            RowBox[{"ang", "[", 
             RowBox[{"[", "t", "]"}], "]"}], ",", "\n", 
            "                                          ", 
            RowBox[{"Transpose", "[", 
             RowBox[{"Table", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"Abs", "[", "#1", "]"}], ",", "1.5"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"i", ",", "lambda"}], "}"}]}], "]"}], "]"}], ",", " ", 
            RowBox[{"(*", 
             RowBox[{"{", 
              RowBox[{"nMat", ",", " ", "nSus"}], "}"}], "*)"}], "\n", 
            "                                          ", "lambda", ",", "\n",
             "                                          ", 
            RowBox[{"cfrac", "[", 
             RowBox[{"[", "c", "]"}], "]"}], ",", "\n", 
            "                                          ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"Abs", "[", "#2", "]"}], ",", "sigma"}], "}"}], ",", 
            "\n", "                                          ", 
            RowBox[{"\"\<SizeDistribution\>\"", "->", "\"\<Normal\>\""}]}], 
           "]"}], "[", 
          RowBox[{"[", "pol", "]"}], "]"}], "]"}], "&"}]}], ";", "\n", 
      "            ", 
      RowBox[{"y", " ", "=", " ", 
       RowBox[{"spectra", "[", 
        RowBox[{"[", 
         RowBox[{"pol", ",", "t", ",", "c", ",", "take", ",", "2"}], "]"}], 
        "]"}]}], ";", "\n", "            ", 
      RowBox[{"error", " ", "=", " ", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Plus", " ", "@@", " ", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"f", "[", 
              RowBox[{"#1", ",", "#2"}], "]"}], " ", "-", " ", "y"}], ")"}]}],
           "^", "2"}], "/", 
         RowBox[{"Length", "[", "lambda", "]"}]}], "&"}]}], ";", "\n", 
      "            ", 
      RowBox[{"result", " ", "=", " ", 
       RowBox[{"AbsoluteTiming", "[", "\n", "                        ", 
        RowBox[{"Prepend", "[", "\n", "                              ", 
         RowBox[{
          RowBox[{"NGradientDescent", "[", 
           RowBox[{"error", ",", 
            RowBox[{"{", 
             RowBox[{"1.33", ",", "3.5"}], "}"}], ",", 
            RowBox[{
            "LearningRate", " ", "->", " ", "\"\<Barzilai-Borwein\>\""}], ",", 
            RowBox[{"Tolerance", "->", " ", "1.*^-5"}]}], "]"}], ",", "\n", 
          "                              ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{
             RowBox[{"{", 
              RowBox[{"\"\<s Pol\>\"", ",", "\"\<p Pol\>\""}], "}"}], "[", 
             RowBox[{"[", "pol", "]"}], "]"}], ",", " ", 
            RowBox[{
             RowBox[{"ang", "[", 
              RowBox[{"[", "t", "]"}], "]"}], "*", 
             RowBox[{"180.", "/", "Pi"}]}], ",", " ", "mu"}], "}"}]}], "]"}], 
        "  ", "]"}]}], ";", "\n", "             ", 
      RowBox[{"Print", "[", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Date", "[", "]"}], ",", " ", "\"\<\\n\>\"", ",", " ", 
         "result"}], "}"}], "]"}], ";", "\n", "             ", 
      RowBox[{"result", "[", 
       RowBox[{"[", "2", "]"}], "]"}]}], ",", "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"t", ",", " ", 
       RowBox[{"Length", "[", "ang", "]"}]}], "}"}], ",", "\n", "      ", 
     RowBox[{"{", 
      RowBox[{"c", ",", 
       RowBox[{"Length", "[", "muSigma", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]], "Code",
 CellChangeTimes->{{3.919093256389165*^9, 3.9190932634706793`*^9}, {
  3.919093412502871*^9, 3.919093501795701*^9}, {3.919093546605267*^9, 
  3.91909358445548*^9}, {3.919093618059577*^9, 3.91909366042227*^9}, {
