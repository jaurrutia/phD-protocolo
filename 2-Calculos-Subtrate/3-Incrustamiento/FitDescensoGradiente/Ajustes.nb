  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"spectra", " ", "=", " ", 
   RowBox[{"Map", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Select", "[", 
       RowBox[{"#", ",", 
        RowBox[{"Function", "[", 
         RowBox[{"list", ",", 
          RowBox[{"wlL", "<=", 
           RowBox[{"list", "[", 
