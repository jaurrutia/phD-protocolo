 RowBox[{
  RowBox[{"nNP", "=", 
   RowBox[{
    RowBox[{"JohnsonChristyAuRefSize", "[", 
     RowBox[{"#1", ",", "#2"}], "]"}], "&"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"pl", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"Style", "[", 
       RowBox[{
        RowBox[{"\"\<a = \>\"", "<>", 
         RowBox[{"ToString", "[", "#1", "]"}], "<>", 
