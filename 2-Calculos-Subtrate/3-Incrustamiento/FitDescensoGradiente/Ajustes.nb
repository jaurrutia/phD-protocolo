   RowBox[{"[", 
    RowBox[{"[", 
     RowBox[{
     "pol", ",", " ", "ang", ",", " ", "thickness", ",", " ", "lda", ",", " ",
       "Ext"}], "]"}], "]"}], "*)"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"spectra", "=", 
    RowBox[{"spectra", "[", 
     RowBox[{"[", 
      RowBox[{";;", ",", ";;", ",", 
       RowBox[{"{", 
        RowBox[{"1", ",", "2"}], "}"}]}], "]"}], "]"}]}], ";"}], 
