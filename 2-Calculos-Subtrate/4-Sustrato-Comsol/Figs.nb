Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"scaleFactor", "[", "h_", "]"}], ":=", 
    RowBox[{"0.5", " ", "-", " ", 
     RowBox[{"0.75", "*", "h"}], " ", "+", " ", 
     RowBox[{"0.25", "*", "h", "*", "h", "*", "h"}]}]}], " ", ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"h", " ", "->", " ", 
     RowBox[{"Incrustation", " ", 
      RowBox[{"factor", ":", " ", 
       RowBox[{
        RowBox[{"h", "/", 
         RowBox[{"a", ".", " ", "h"}]}], " ", "Distance", " ", "between", " ",
         "center", " ", "and", " ", "interface"}]}]}]}], ",", " ", 
    RowBox[{"a", " ", "AuNP", " ", "radius"}]}], "*)"}]}], "\n", 
 RowBox[{"radiusM", " ", "=", " ", 
  RowBox[{"{", 
   RowBox[{"5.78", ",", " ", "7.30"}], "}"}]}], "\n", 
 RowBox[{
  RowBox[{"radiusF", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"3.3", ",", " ", "4.5"}], "}"}]}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"Plot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"scaleFactor", "[", "h", "]"}], "-", "#"}], " ", ",", 
     RowBox[{"{", 
      RowBox[{"h", ",", 
       RowBox[{"-", "1"}], ",", "1"}], "}"}]}], "]"}], "&"}], " ", "/@", " ", 
  
  RowBox[{"(", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{"radiusF", "/", "radiusM"}], ")"}], "^", "3"}], ")"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"FindRoot", "[", 
    RowBox[{
     RowBox[{
      RowBox[{
       RowBox[{"scaleFactor", "[", "h", "]"}], "-", 
       RowBox[{"#", "^", "3"}]}], " ", "==", " ", "0"}], ",", " ", 
     RowBox[{"{", 
      RowBox[{"h", ",", ".1"}], "}"}]}], " ", "]"}], " ", "&"}], " ", "/@", 
  " ", 
  RowBox[{"(", 
   RowBox[{"radiusF", "/", "radiusM"}], ")"}]}], "\n", 
