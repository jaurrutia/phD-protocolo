Cell[BoxData[{
 RowBox[{
  RowBox[{"max", " ", "=", " ", 
   RowBox[{"Max", "[", 
    RowBox[{"data", "[", 
     RowBox[{"[", 
      RowBox[{";;", ",", ";;", ",", "4"}], "]"}], "]"}], "]"}]}], " ", 
  RowBox[{"(*", 
   RowBox[{"To", " ", "normalize", " ", "all", " ", "cases"}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"case", " ", "=", " ", 
    RowBox[{"ConstantArray", "[", 
     RowBox[{
      RowBox[{"-", "1"}], ",", "2"}], "]"}]}], ";"}], " ", 
  RowBox[{"(*", 
   RowBox[{
   "To", " ", "place", " ", "above", " ", "or", " ", "below", " ", "the", " ",
     "glass"}], "*)"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{"dataX", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"data", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"Abs", "[", 
          RowBox[{"#", "[", 
           RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", ".001"}], "   ", 
        "&"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "data", "]"}]}], "}"}]}], "]"}]}], 
  ";"}], "\n", 
 RowBox[{
  RowBox[{"dataX", " ", "=", " ", 
   RowBox[{"MapThread", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"#1", "/.", " ", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x_", ",", "y_", ",", "z_", ",", "norm_"}], "}"}], " ", "->",
         " ", 
        RowBox[{"{", 
         RowBox[{"y", ",", " ", 
          RowBox[{"#2", " ", "*", " ", 
           RowBox[{"-", "z"}]}], ",", " ", 
          RowBox[{"norm", "/", "max"}]}], "}"}]}]}], " ", "&"}], ",", 
     RowBox[{"{", 
      RowBox[{"dataX", ",", " ", "case"}], "}"}]}], "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{"dataX", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Select", "[", 
      RowBox[{
       RowBox[{"dataX", "[", 
        RowBox[{"[", "i", "]"}], "]"}], ",", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "1", "]"}], "]"}], "]"}], "<", "limData"}], " ", "&&",
           " ", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{"#", "[", 
             RowBox[{"[", "2", "]"}], "]"}], "]"}], "<", "limData"}]}], ")"}],
         " ", "&"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", 
       RowBox[{"Length", "[", "dataX", "]"}]}], "}"}]}], "]"}]}], 
  ";"}]}], "Code",
